{
  "name": "magic-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @mtg/web dev",
    "cards:fixture": "pnpm --filter @mtg/compiler compile -- --input packages/compiler/test/fixtures/scryfall-sample.json --out apps/web/public",
    "cards:build": "pnpm --filter @mtg/compiler compile -- --download --out apps/web/public",
    "rules:parse": "pnpm --filter @mtg/rules cli parse docs/rules/MagicCompRules.txt docs/rules/rules.json",
    "rules:trace": "pnpm --filter @mtg/rules cli trace",
    "rules:check": "pnpm --filter @mtg/rules cli trace --check",
    "demo": "pnpm --filter @mtg/engine demo -- ../../apps/web/public/cards.json.gz ../../.cache/replay.json && node tools/replay/build.cjs tools/replay/template.html .cache/replay.json docs/rules/rules.json .cache/replay.html"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
